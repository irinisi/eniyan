# Оставьте пустым для локального запуска — backend сам найдёт teamos/vault.
# Используйте абсолютный путь (или /vault в docker-compose), относительный
# путь резолвится от текущей рабочей директории процесса и легко ломается.
TEAMOS_VAULT_PATH=
TEAMOS_API_BASE_URL=http://localhost:8000
TEAMOS_MINIAPP_URL=https://your-domain.example/miniapp
TEAMOS_DIGEST_CHAT_ID=
# Тоже оставьте пустым, чтобы использовать teamos/backups по умолчанию.
TEAMOS_BACKUP_DIR=
TEAMOS_BACKUP_KEEP=30
TELEGRAM_BOT_TOKEN=
